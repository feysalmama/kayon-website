# Copy this file to .env and replace both secrets before starting Docker.
POSTGRES_USER=kayon
POSTGRES_PASSWORD=replace_with_a_long_random_password_using_letters_and_numbers
POSTGRES_DB=kayon
POSTGRES_PORT=5433
DATABASE_URI=postgres://kayon:replace_with_a_long_random_password_using_letters_and_numbers@localhost:5433/kayon?sslmode=disable
PAYLOAD_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Optional licensed video files (paths served by the app, e.g. /media/hero.mp4)
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_PRINTER_VIDEO=
NEXT_PUBLIC_VISITOR_VIDEO=
NEXT_PUBLIC_IDENTITY_VIDEO=
